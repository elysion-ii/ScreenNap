<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1707: xUnit test names intentionally use Method_Scenario underscore convention -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Builds ScreenNap before the tests; the tests start its executable, never load its assembly -->
    <ProjectReference Include="..\ScreenNap\ScreenNap.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ScreenNapExe</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\ScreenNap\bin\$(Configuration)\net10.0-windows\win-x64\ScreenNap.exe</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
