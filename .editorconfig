# Shared code style for editors and `dotnet format`.
# Rule IDs in comments refer to docs/rules/dotnet.md.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# XML-based project files follow the 2-space convention
[*.{csproj,slnx,props,targets,resx,xml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown
trim_trailing_whitespace = false

[*.cs]
# NAMESPACE: file-scoped namespaces only
csharp_style_namespace_declarations = file_scoped:warning

# VAR: var when the type is apparent from the right-hand side, explicit otherwise
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# VISIBILITY: no public type in an application, and every declaration except an interface member writes its modifier
dotnet_diagnostic.CA1515.severity = warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning

# DEFERRED: a second enumeration of an IEnumerable re-runs the whole query
dotnet_diagnostic.CA1851.severity = warning

# UNUSED: a member or parameter the change stopped reaching fails the build (standard.md Leave No Vestiges)
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# Usings: outside namespace, System directives first
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
