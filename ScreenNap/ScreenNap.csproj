<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\icon-normal.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>

    <!-- The installer ships whatever the publish directory holds, so debug
         symbols left in the intermediate output must not be copied there. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon-normal.ico" />
    <EmbeddedResource Include="Resources\icon-active.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScreenNap.Tests" />
  </ItemGroup>

  <!-- The AOT compiler links the satellite resources into the executable, and the
       portable distribution is a single file (docs/specs/ScreenNap.md). -->
  <Target Name="RemoveSatelliteAssembliesFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.dll' And $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').EndsWith('.resources'))" />
    </ItemGroup>
  </Target>

</Project>
