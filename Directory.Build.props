<Project>
  <!-- Build settings shared by every project in this repository.
       Project-specific settings belong in each .csproj. -->
  <PropertyGroup>
    <!-- Single source of truth for the app version. Do not define <Version>
         anywhere else: every artifact and every displayed version derives from
         this value (see docs/rules/dotnet.md, VERSION). -->
    <Version>1.8.0</Version>

    <!-- The SDK supplies 1.0.0 for a missing <Version>, so the guard below compares what
         this file declared, captured before the SDK's default applies. -->
    <DeclaredVersion>$(Version)</DeclaredVersion>

    <!-- Keep AssemblyInformationalVersion equal to <Version> by default: the SDK otherwise
         appends "+<git sha>", and ScreenNap displays the bare <Version>
         (see docs/rules/dotnet.md, VERSION; docs/rules/standard.md, Version Display). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Static analysis: built-in Roslyn analyzers + .editorconfig style rules -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Warnings are build errors. Never turn this off; relax individual
         diagnostics at the narrowest scope with a reason
         (see docs/rules/dotnet.md, ANALYZERS). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- VSTHRD analyzers enforce the async rules mechanically (e.g. VSTHRD002:
         no .Result/.Wait() blocking on async code). See docs/rules/dotnet.md,
         ASYNC. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- BannedSymbols.txt lists the APIs no code may call; every use is RS0030, a
         build error (see docs/rules/dotnet.md, ANALYZERS). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.*" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!-- Publish outputs omit debug symbols by default (DebugType=none covers only this
       build's own symbols, while transitive packages can carry .pdb files beside their
       libraries). -->
  <Target Name="RemoveSymbolsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- Every build carries the product version ScreenNap displays (specification VER-1);
       a build without one fails instead of producing an executable with no version. -->
  <Target Name="RequireDeclaredVersion" BeforeTargets="BeforeBuild"
          Condition="'$(DeclaredVersion)' == ''">
    <Error Text="Directory.Build.props declares no &lt;Version&gt;. Define the product version there (docs/rules/dotnet.md, VERSION)." />
  </Target>

  <!-- A single file that unpacks itself at run time is prohibited: it writes a
       per-build directory under the temp folder that nothing deletes automatically.
       Both the project and a framework can turn this on, so the guard checks the
       resolved values. -->
  <Target Name="ForbidSelfExtractingPublish"
          BeforeTargets="GenerateSingleFileBundle"
          Condition="'$(IncludeNativeLibrariesForSelfExtract)' == 'true' Or '$(IncludeAllContentForSelfExtract)' == 'true'">
    <Error Text="This single-file publish would unpack itself into the temp folder on every new build, and nothing deletes what it leaves there. IncludeNativeLibrariesForSelfExtract=$(IncludeNativeLibrariesForSelfExtract), IncludeAllContentForSelfExtract=$(IncludeAllContentForSelfExtract). Remove whichever the project sets or publish side-by-side without PublishSingleFile." />
  </Target>
</Project>
